{
  "name": "guardian-gate-minigame",
  "version": "0.1.0",
  "private": true,
  "description": "今天也没守住微信小游戏独立版本",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-project.mjs",
    "test": "node scripts/test-simulation.mjs && npm run test:combat-rules && npm run test:projection && npm run test:difficulty && npm run test:war-points && npm run test:campaign-balance && npm run test:endless && npm run test:balance && npm run test:campaign && npm run test:subpackage",
    "test:combat-rules": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/combat-rules-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/combat-rules-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:projection": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/combat-projection-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/combat-projection-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:difficulty": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/difficulty-authority-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/difficulty-authority-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:war-points": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/war-points-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/war-points-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:campaign-balance": "node -e \"process.env.CAMPAIGN_BALANCE_SUMMARY='1';const e=require('esbuild'),f=require('node:fs');const o='.tmp/campaign-balance-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/campaign-balance-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:endless": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/endless-simulation-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/endless-simulation-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:balance": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/endless-balance-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/endless-balance-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:campaign": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/campaign-storage-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/campaign-storage-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "test:subpackage": "node -e \"const e=require('esbuild'),f=require('node:fs');const o='.tmp/subpackage-runtime-smoke.cjs';f.mkdirSync('.tmp',{recursive:true});try{e.buildSync({entryPoints:['scripts/subpackage-runtime-smoke.ts'],outfile:o,bundle:true,platform:'node',format:'cjs',target:['node20']});require('./'+o)}finally{f.rmSync(o,{force:true})}\"",
    "qa": "npm run typecheck && npm run build && npm run check && npm run test",
    "dev": "npm run build && \"/Applications/wechatwebdevtools.app/Contents/MacOS/cli\" open --project \"$PWD\" --lang zh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
